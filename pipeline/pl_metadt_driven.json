{
	"name": "pl_metadt_driven",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlPoolSource",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "SqlPoolTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup1').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Notebook1",
							"type": "SynapseNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebook": {
									"referenceName": "nb_bronze_ingest",
									"type": "NotebookReference"
								},
								"parameters": {
									"source_container": {
										"value": {
											"value": "@item().source_container",
											"type": "Expression"
										},
										"type": "string"
									},
									"source_folder": {
										"value": {
											"value": "@item().source_folder",
											"type": "Expression"
										},
										"type": "string"
									},
									"target_container": {
										"value": {
											"value": "@item().target_container",
											"type": "Expression"
										},
										"type": "string"
									},
									"target_folder": {
										"value": {
											"value": "@item().target_folder",
											"type": "Expression"
										},
										"type": "string"
									}
								},
								"snapshot": true,
								"sparkPool": {
									"referenceName": "sparkpool",
									"type": "BigDataPoolReference"
								}
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}